          "legendFormat": "p99 Inference Latency",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "p99 Inference Latency SLA (< 5 ms)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
