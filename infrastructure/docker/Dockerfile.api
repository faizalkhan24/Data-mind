# ==============================================================================
# DataMind.Api Service Dockerfile
# Multi-Stage Production Build (Core Fleet Management & Relational Persistence)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Dependencies & Wheels
# ------------------------------------------------------------------------------
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# ------------------------------------------------------------------------------
# Stage 2: Minimal Production Runtime
# ------------------------------------------------------------------------------
FROM python:3.11-slim AS runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 10001 datamind && \
    useradd -u 10001 -g datamind -s /bin/bash -m datamind

COPY --from=builder /root/.local /home/datamind/.local
ENV PATH=/home/datamind/.local/bin:$PATH
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

COPY services/DataMind.Api/ /app/services/DataMind.Api/

RUN chown -R datamind:datamind /app /home/datamind

USER datamind

EXPOSE 8001

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

CMD ["python", "-m", "uvicorn", "services.DataMind.Api.main:app", "--host", "0.0.0.0", "--port", "8001"]
